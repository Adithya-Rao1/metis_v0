# PLACEHOLDERS ONLY. Copy to deploy/.env (ignored by source control) and set real values locally.
# Never commit real values.
# Only the METIS_* variables in the 'app' section reach the app container (see docker-compose.yml);
# POSTGRES_PASSWORD, METIS_MIGRATION_URL, METIS_APP_DB_PASSWORD and REDIS_PASSWORD never do.
METIS_ENV=development
POSTGRES_PASSWORD=<set-me-owner-password>
METIS_APP_DB_PASSWORD=<set-me-app-role-password>
METIS_DATABASE_URL=postgresql+psycopg://metis_app_login:<set-me-app-role-password>@postgres:5432/metis
METIS_MIGRATION_URL=postgresql://metis_owner:<set-me-owner-password>@postgres:5432/metis
METIS_SECRET_KEY=<set-me-at-least-32-random-characters>
METIS_REDIS_URL=redis://:<set-me-redis-password>@redis:6379/0
REDIS_PASSWORD=<set-me-redis-password>
METIS_OBJECT_STORE_ENDPOINT=http://minio:9000
METIS_OBJECT_STORE_ACCESS_KEY=<set-me-minio-access-key>
METIS_OBJECT_STORE_SECRET_KEY=<set-me-minio-secret-key>
METIS_OBJECT_STORE_BUCKET=metis
