# PLACEHOLDERS ONLY. Copy to deploy/.env (ignored by source control) and set real values locally.
# Never commit real values.
# Only the variables listed under 'app: environment' in docker-compose.yml reach the app container;
# POSTGRES_PASSWORD, METIS_MIGRATION_URL, METIS_APP_DB_PASSWORD, REDIS_PASSWORD and MINIO_ROOT_* never do.
METIS_ENV=development
POSTGRES_PASSWORD=<set-me-owner-password>
METIS_APP_DB_PASSWORD=<set-me-app-role-password>
METIS_DATABASE_URL=postgresql+psycopg://metis_app_login:<set-me-app-role-password>@postgres:5432/metis
METIS_MIGRATION_URL=postgresql://metis_owner:<set-me-owner-password>@postgres:5432/metis
METIS_SECRET_KEY=<set-me-at-least-64-random-bytes>
METIS_REDIS_URL=redis://:<set-me-redis-password>@redis:6379/0
REDIS_PASSWORD=<set-me-redis-password>
METIS_OBJECT_STORE_ENDPOINT=http://minio:9000
# MinIO ROOT credential: only the minio service gets it. Never reuse it for the app.
MINIO_ROOT_USER=<set-me-minio-root-user>
MINIO_ROOT_PASSWORD=<set-me-minio-root-password>
# The app's own access key: create it in MinIO (mc admin user add + a policy limited to the bucket below) after the
# first start, then put it here. It must differ from the root credential.
METIS_OBJECT_STORE_ACCESS_KEY=<set-me-app-access-key>
METIS_OBJECT_STORE_SECRET_KEY=<set-me-app-secret-key>
METIS_OBJECT_STORE_BUCKET=metis

# Set to true ONLY behind your own reverse proxy that appends the real client IP as the LAST X-Forwarded-For hop.
# Leave false otherwise (the app then rate-limits by socket peer address).
METIS_ACCOUNTS_TRUST_PROXY=false

# Optional: any other documented setting (docs/OPERATIONS.md, sections 1 and 7) can be added here and is passed through,
# for example METIS_LEAD_DOCK_URL (exact origin of a private DynamicBind host), STUDIO_RUN_TIMEOUT, STUDIO_FORCE_MOCK=1.
# Do not set STUDIO_ALL_EDITS in production: the app refuses to start with it.
